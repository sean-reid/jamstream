<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements applied when codesigning JamStream.app with the hardened
     runtime. Without audio-input, the hardened runtime denies microphone
     capture at runtime, which is the app's whole job. The CLI is signed
     without entitlements: it does no audio capture. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
