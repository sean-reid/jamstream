# CLI only, from the official release tarball. The binary links glibc,
# libm, and libgcc_s and nothing else. Local hosting with the CLI alone
# also wants jamstreamd, which jamstream-bin installs.
pkgname=jamstream-cli-bin
_tag=v0.1.6
pkgver=0.1.6
pkgrel=1
pkgdesc="Terminal client for jam sessions hosted in your own cloud account"
arch=('x86_64')
url="https://sean-reid.github.io/jamstream"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
optdepends=('jamstream-bin: desktop app and the jamstreamd session server')
provides=('jamstream')
conflicts=('jamstream')
options=('!strip' '!debug')
source=("jamstream-cli-$pkgver-x86_64.tar.gz::https://github.com/sean-reid/jamstream/releases/download/$_tag/jamstream-cli-linux-x86_64.tar.gz"
        "LICENSE-MIT-$pkgver::https://raw.githubusercontent.com/sean-reid/jamstream/$_tag/LICENSE-MIT"
        "LICENSE-APACHE-$pkgver::https://raw.githubusercontent.com/sean-reid/jamstream/$_tag/LICENSE-APACHE")
